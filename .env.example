# Copia este archivo como .env y completa tus valores. NUNCA subas el .env real.

# Base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/onboarding

# Firma de los tokens de sesión (usa una cadena larga y aleatoria)
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# IA: gemini | groq | openai | claude
AI_PROVIDER=gemini

# Claves de IA (solo la del proveedor que uses; Gemini también se usa para la base de conocimiento)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Opcional: orígenes permitidos por CORS, separados por coma
# CORS_ORIGINS=https://app.tudominio.com
# Opcional: umbral de relevancia de la base de conocimiento (0 a 1)
# RAG_UMBRAL=0.62
